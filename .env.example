# Placeholders only. Copy to .env (git-ignored) and adjust. Never commit real values.
POSTGRES_DB=acd
POSTGRES_USER=acd
POSTGRES_PASSWORD=change-me

ACD_ENVIRONMENT=development
ACD_TENANT_ID=00000000-0000-0000-0000-000000000000
ACD_SUBSCRIPTION_IDS=00000000-0000-0000-0000-000000000000
ACD_FRESHNESS_HOURS=24
ACD_RETENTION_MONTHS=13
ACD_CORS_ORIGINS=http://localhost:8080
ACD_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
ACD_AUTH_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ACD_AUTH_SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ACD_AUTH_API_CLIENT_SECRET is set in the runtime environment only; never commit it.
ACD_AUTH_COLLECTOR_MODE=managed_identity
