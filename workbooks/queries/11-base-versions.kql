// @id base-versions
// @tab baselines
// @title Version cohorts (configuration version as exposed by the assignment)
// @note gcVersion is properties.guestConfiguration.version from the assignment. A selector such as 1.* is not a resolved package version; blank means the projection did not expose it.
// @note Configuration version, package/module version, policy definition version, benchmark version/profile and OS build are different dimensions; only the first is shown here.
// @note Benchmark version and profile are NOT derivable from ARG and are never inferred.
// @nodata No guest configuration assignments for the baseline families in scope.
//#include assignments
| join kind=inner (
    //#include machines
  ) on machineId
| summarize assignmentsCount = count(), machinesCount = dcount(machineId), withReport = countif(hasReport == true) by family, gcVersion = iff(gcVersion == '', '(not exposed)', gcVersion)
| order by family asc, gcVersion asc
