// @id cat-checks
// @tab categories
// @title Checks in the selected category (select a row to open check/reason detail)
// @export checkKey=CheckKey
// @note Requires a category row selected above. One row per unique check key per family across Fresh reports.
// @note reasonsReported is the sum of reasons attached to the check and is NOT a check count.
// @nodata Select a category above, or no Fresh checks in the category.
//#include machines
//#include assignments
//#include evidence
//#include checks
freshChecks
| where '{Category}' != '-' and category == '{Category}'
| where '{Family}' == '*' or family == '{Family}'
| summarize machinesTested = dcount(machineId), machinesFailing = dcountif(machineId, checkStatus == 'NonCompliant'), reasonsReported = sum(reasonCount) by family, checkKey
| order by machinesFailing desc
