resources
| where type in~ ('microsoft.compute/virtualmachines', 'microsoft.hybridcompute/machines')
| where '*' in ({ResourceGroups}) or resourceGroup in~ ({ResourceGroups})
| extend machineId = tolower(id)
| extend machineKind = iff(type =~ 'microsoft.hybridcompute/machines', 'ArcMachine', 'AzureVM')
| extend osType = tolower(tostring(iff(machineKind == 'ArcMachine', properties.osType, properties.storageProfile.osDisk.osType)))
| extend eligibility = case(osType == 'windows', 'Eligible', osType == 'linux', 'NotEligible', 'Unknown')
| project machineId, machineName = name, machineKind, subscriptionId, resourceGroup, location, osType, eligibility
