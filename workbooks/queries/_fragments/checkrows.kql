//#include evidence
| extend resources = iff(array_length(resources) > 0, resources, dynamic([null]))
| mv-expand r = resources limit 2000
| extend checkKey = tostring(r.resourceId)
| extend status = iff(tolower(tostring(r.complianceStatus)) in ('true', 'compliant'), 'Compliant', 'NonCompliant')
| extend reasonCount = coalesce(array_length(r.reasons), 0)
| summarize checkStatus = iff(countif(status == 'NonCompliant') > 0, 'NonCompliant', 'Compliant'), reasonCount = sum(reasonCount) by machineId, machineName, family, eligibility, quality, green, checkKey
| extend category = coalesce(extract(@'^\[([^\]]+)\]', 1, checkKey), 'Uncategorized')
