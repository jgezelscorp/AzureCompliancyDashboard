  "policyKeywordRules": [
    {"id": "kw-backup", "domain": "backup-resilience", "pattern": "backup|site recovery|geo-redundant|disaster recovery"},
    {"id": "kw-tags", "domain": "cost-tagging", "pattern": "\\btags?\\b|\\bcost\\b"},
    {"id": "kw-logging", "domain": "logging-monitoring", "pattern": "diagnostic|log analytics|logging|activity log|resource logs|\\balerts?\\b|monitoring agent|log retention"},
    {"id": "kw-data", "domain": "data-protection", "pattern": "encrypt|customer-managed key|\\bcmk\\b|\\btls\\b|\\bssl\\b|https|key vault|secrets?\\b|certificate|purge protection|soft delete|double encryption"},
    {"id": "kw-network", "domain": "network", "pattern": "private (link|endpoint)|public network|public access|firewall|virtual network|\\bvnet\\b|network security group|\\bnsg\\b|ip forwarding|inbound|subnet|service endpoint|network access"},
    {"id": "kw-identity", "domain": "identity", "pattern": "managed identity|multi-factor|\\bmfa\\b|\\brbac\\b|service principal|authentication|password|local auth|entra|azure ad|guest account|least privilege|credentials|\\bowner\\b"},
    {"id": "kw-endpoint", "domain": "endpoint-os", "pattern": "vulnerabilit|endpoint protection|antimalware|defender|patch|system updates|secure boot|\\bvtpm\\b|trusted launch|guest configuration|machine configuration|kubernetes|container|\\bwindows\\b|\\blinux\\b"},
    {"id": "kw-governance", "domain": "governance", "pattern": "allowed locations|allowed resource|regulatory|governance|naming|compliance"}
  ],
